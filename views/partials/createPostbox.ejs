<div id="direct_post_box"
    class="direct-post-box w-full max-[500px]:h-dvh bg-black flex flex-col max-[500px]:hidden max-[500px]:fixed max-[500px]:inset-0 max-[500px]:z-50 overscroll-none">

<div class="flex items-center justify-between p-4 border-b border-gray-800 min-[500px]:hidden">
    <button id="cross_btn_fomo" class="text-white text-xl font-bold">✕</button>
    <button type="submit" form="myForm" class="bg-amber-50 text-black font-bold px-5 py-1.5 rounded-full hover:bg-[#c4d1db] transition-all duration-200">Post</button>
</div>
    
    <div class="allWraper flex w-full h-full">
        <div class="post-sec1 h-fit min-[500px]:h-full py-4 flex">
            <img class="profile-img w-10 h-10 object-cover shrink-0 rounded-full mr-3.5 ml-4" src="profile-img.jpeg"
                alt="">
        </div>

        <!-- ------- post form -------- -->
        <form action="/create-post" method="post" enctype="multipart/form-data" id="myForm" class="w-full h-full">
            <div class="post-sec2 w-full h-full flex flex-col pt-4">

                <div class="wrape_textarea_showPOstCon grow ">
                    <textarea name="post-title" id="post-title" maxlength="280"
                        class=" w-full pr-2 py-3 break-normal wrap-anywhere resize-none border-none outline-none overflow-hidden field-sizing-content min-h-10 text-[20px] font-[370]"
                        placeholder="What's happening?" required></textarea>
                    <!-- -----------show-post-content which is selected by user----------- -->
                    <div class="show-post-content max-w-130  max-[500px]:w-full pr-4 flex flex-wrap gap-2 ">
                        <!-- ------------ selected content yehi per ayega JS se ---------------------- -->
                    </div>
                </div>
                <div class="wraper-post-btn-icons w-full min-[500px]:sticky min-[500px]:bottom-0">
                    <div
                        class="btn w-fit text-[15px] flex items-center justify-center space-x-1.5 text-blue-400 font-medium rounded-full px-1.5 my-3 hover:bg-[#04acfa28] transition-all duration-200">
                        <div><svg xmlns="http://w3.org" viewBox="0 0 24 24" width="17" height="17" fill="currentColor">
                                <g>
                                    <path
                                        d="M12 1.75C6.34 1.75 1.75 6.34 1.75 12S6.34 22.25 12 22.25 22.25 17.66 22.25 12 17.66 1.75 12 1.75zm-.25 10.48L10.5 17.5l-2-1.5v-3.5L7.5 9 5.03 7.59c1.42-2.24 3.89-3.75 6.72-3.84L11 6l-2 .5L8.5 9l5 1.5-1.75 1.73zM17 14v-3l-1.5-3 2.88-1.23c1.17 1.42 1.87 3.24 1.87 5.23 0 1.3-.3 2.52-.83 3.61L17 14z" />
                                </g>
                            </svg>
                        </div>
                        <button>Everyone can reply</button>
                    </div>
                    <hr class="text-[#363636]">

                    <div class="post-bottom  w-full flex items-center justify-between">

                        <div class="icons flex space-x-2 pt-2 ">

                            <div class="media post-ele">
